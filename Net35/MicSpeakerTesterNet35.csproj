  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    Single-exe packaging without any IL-merge tool (ILRepack/Costura both risk being flagged as
    heuristic false positives by some antivirus engines, and Costura needs netstandard2.0 which
    .NET Framework 3.5 can't load anyway). Instead: embed NAudio.dll as a plain resource straight
    from the restored NuGet package, and resolve it at runtime via AppDomain.AssemblyResolve
    (see Program.cs). This is a normal single assembly with an embedded byte blob - nothing about
    its PE structure resembles a packed/merged executable.
  -->
  <Target Name="EmbedNAudioDll" AfterTargets="ResolveReferences" BeforeTargets="AssignTargetPaths;CoreCompile">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'NAudio' And '%(ReferencePath.Extension)' == '.dll'">
        <LogicalName>NAudio.dll</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
  <Target Name="RemoveLooseNAudioDll" AfterTargets="Build" Condition="Exists('$(TargetDir)NAudio.dll')">
    <Delete Files="$(TargetDir)NAudio.dll" />
  </Target>
</Project>